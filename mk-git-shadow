#!/usr/bin/env python3
"""Create a writable shadow Git repository.

This script creates a *shadow* Git repository that inherits objects from the
current repository via Git’s *alternates* feature and creates a worktree that
points back to the current working directory.

Usage::

    mk-git-shadow <git-dir-ref-file>

Where ``<git-dir-ref-file>`` is the path to the file that will contain a
``gitdir: <path>`` line pointing to the new worktree.

The source may use loose or packed refs and may itself be a linked worktree.
"""

from __future__ import annotations

import shutil
import subprocess
import sys
from pathlib import Path


def run(
    cmd: list[str], *, capture_stdout: bool = False, check: bool = True
) -> subprocess.CompletedProcess[str]:
    """Convenience wrapper around :func:`subprocess.run`.

    Parameters
    ----------
    cmd:
        Command and arguments to execute.
    capture_stdout:
        If ``True`` the command’s stdout is captured. Stderr remains visible.
    check:
        If ``True``, raise an exception when the command fails.
    """
    return subprocess.run(
        cmd,
        check=check,
        stdout=subprocess.PIPE if capture_stdout else None,
        text=True,
    )


def git_path(option: str) -> Path:
    """Return an absolute path reported by ``git rev-parse``."""
    value = run(
        ["git", "rev-parse", option], capture_stdout=True
    ).stdout.strip()
    return Path(value).resolve()


def create_shadow(argument: str) -> None:
    """Create the requested shadow repository."""
    git_dir_ref = Path(argument).resolve()
    if git_dir_ref.name == ".git":
        raise ValueError("git-dir-ref cannot be .git")

    source_worktree = git_path("--show-toplevel")
    if Path.cwd().resolve() != source_worktree:
        raise ValueError("run this command from the repository root")

    source_git_dir = git_path("--absolute-git-dir")
    source_common_dir = git_path("--git-common-dir")
    source_head = source_git_dir / "HEAD"
    source_config = source_common_dir / "config"
    source_objects = source_common_dir / "objects"

    # Resolve source state before creating any output paths.
    branch_result = run(
        ["git", "symbolic-ref", "--quiet", "--short", "HEAD"],
        capture_stdout=True,
        check=False,
    )
    branch = branch_result.stdout.strip() if branch_result.returncode == 0 else ""
    head_result = run(
        ["git", "rev-parse", "--verify", "--quiet", "HEAD"],
        capture_stdout=True,
        check=False,
    )
    head = head_result.stdout.strip() if head_result.returncode == 0 else ""

    # The shadow git directory is <git_dir_ref>_.
    git_dir = git_dir_ref.with_name(git_dir_ref.name + "_")
    git_dir.mkdir(parents=True, exist_ok=True)

    # Point object alternates to the source repository. An absolute path works
    # regardless of where the git-dir reference is created.
    (git_dir / "objects" / "info").mkdir(parents=True, exist_ok=True)
    alternates_file = git_dir / "objects" / "info" / "alternates"
    alternates_file.write_text(f"{source_objects}\n")

    shutil.copy2(source_head, git_dir / "HEAD")

    # Git requires refs/heads to recognize an otherwise empty repository.
    git_dir_ref_head = git_dir / "refs" / "heads"
    git_dir_ref_head.mkdir(parents=True, exist_ok=True)
    if branch and head:
        run(
            [
                "git",
                "--git-dir",
                str(git_dir),
                "update-ref",
                f"refs/heads/{branch}",
                head,
            ]
        )

    # Copy configuration without giving the shadow access to source remotes.
    shutil.copy2(source_config, git_dir / "config")
    remotes = run(
        ["git", "--git-dir", str(git_dir), "remote"], capture_stdout=True
    ).stdout.splitlines()
    for remote in remotes:
        if remote:
            run(["git", "--git-dir", str(git_dir), "remote", "remove", remote])

    worktree_dir = git_dir / "worktrees" / "current"
    worktree_dir.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source_head, worktree_dir / "HEAD")
    (worktree_dir / "commondir").write_text("../..\n")

    git_dir_ref.write_text(f"gitdir: {worktree_dir}\n")
    run(["git", "--git-dir", str(git_dir_ref), "reset"])

    print(f"Shadow repository created at {git_dir_ref}")


def main(argv: list[str]) -> int:
    if len(argv) != 1:
        print(f"Usage: {Path(sys.argv[0]).name} <git-dir-ref-file>", file=sys.stderr)
        return 2

    try:
        create_shadow(argv[0])
    except ValueError as error:
        print(f"{Path(sys.argv[0]).name}: {error}", file=sys.stderr)
        return 2
    except subprocess.CalledProcessError as error:
        print(
            f"{Path(sys.argv[0]).name}: command failed with status "
            f"{error.returncode}: {error.cmd[0]}",
            file=sys.stderr,
        )
        return error.returncode or 1
    except OSError as error:
        print(f"{Path(sys.argv[0]).name}: {error}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
